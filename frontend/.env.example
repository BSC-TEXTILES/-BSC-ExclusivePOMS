# ============================================================
#  POMS FRONTEND — environment template
#  Copy to .env (local) or configure in the Vercel dashboard.
# ============================================================

# Base URL of the backend API.
#  - Leave UNSET for local single-origin development (Vite dev server proxies
#    /api to localhost:4040, or the backend serves the built dist itself).
#  - For Vercel + Render deployment set it to the Render backend URL, e.g.:
# VITE_API_BASE=https://poms-api.onrender.com/api
VITE_API_BASE=
