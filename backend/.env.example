# ============================================================
#  POMS BACKEND — environment template
#  Copy to .env (local) or configure in the Render dashboard.
#  NEVER commit the real .env file.
# ============================================================

# ── Server ────────────────────────────────────────────────
# Render injects PORT automatically; keep 4040 for local single-origin dev.
PORT=4040
NODE_ENV=development           # set to "production" when deploying

# ── Database ──────────────────────────────────────────────
# Local dev cluster (start-database.bat): postgresql://postgres@localhost:5432/poms
# Supabase (production, Pooler/transaction mode, port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres@localhost:5432/poms

# ── Auth secrets ──────────────────────────────────────────
# REQUIRED in production — minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=8h
REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API, e.g.
#   https://poms.vercel.app,https://poms-bsc.vercel.app
# Leave empty to allow same-origin only (single-origin deployment on Render).
CORS_ORIGIN=

# ── Demo mode (login page) ────────────────────────────────
# When true, the login page shows the seeded demo-account cards with their
# passwords. Default: on outside production; production hides them unless
# DEMO_MODE=true is set explicitly. ALWAYS set DEMO_MODE=false on real systems.
DEMO_MODE=

# ── File storage ──────────────────────────────────────────
# local    → files kept on the server disk (single-origin LAN deployments)
# supabase → files pushed to Supabase Storage (recommended for Render+Vercel)
STORAGE_DRIVER=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role-key-from-supabase-settings-api>
# SUPABASE_BUCKET=poms-uploads
