# ============================================================
#  POMS BACKEND — environment template
#  Copy to .env (local) or configure in the Render dashboard.
#  NEVER commit the real .env file.
# ============================================================

# ── Server ────────────────────────────────────────────────
# Render injects PORT automatically; keep 4040 for local single-origin dev.
PORT=4040
NODE_ENV=development           # set to "production" when deploying

# ── Database ──────────────────────────────────────────────
# Local dev cluster (run.bat): postgresql://postgres@localhost:5432/poms
# Supabase (production):
#   Option A — Pooler (transaction mode, port 6543, best for serverless):
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Option B — Direct connection (port 5432):
#     postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# SSL is auto-detected when "supabase" appears in the URL.
DATABASE_URL=postgresql://postgres.ourgavodqmocfotlilio:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Clerk Authentication ──────────────────────────────────
# From Clerk Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# ── CORS ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API, e.g.
#   https://poms.vercel.app,https://poms-bsc.vercel.app
# Leave empty to allow same-origin only (single-origin deployment on Render).
CORS_ORIGIN=

# ── Demo mode (login page) ────────────────────────────────
# When true, the login page shows the seeded demo-account cards with their
# passwords. Default: on outside production; production hides them unless
# DEMO_MODE=true is set explicitly. ALWAYS set DEMO_MODE=false on real systems.
DEMO_MODE=

# ── File storage ──────────────────────────────────────────
# local    → files kept on the server disk (single-origin LAN deployments)
# supabase → files pushed to Supabase Storage (recommended for Render+Vercel)
STORAGE_DRIVER=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role-key-from-supabase-settings-api>
# SUPABASE_BUCKET=poms-uploads

# ── Purchase Order QR codes ──────────────────────────────
# Public base URL that PO QR codes link to (e.g. https://poms.example.com).
# When empty, the QR deep link is built from the request host automatically.
PUBLIC_APP_URL=

# ── Security settings ─────────────────────────────────────
# Rate limiting: requests per minute for general API surface
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# File upload limits
MAX_FILE_SIZE_MB=200
MAX_FILES_PER_UPLOAD=20

# ── Logging ───────────────────────────────────────────────
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Security event logging
SECURITY_LOG_ENABLED=true
